# L.A.I.L — Local AI Lab
# Copy to .env and adjust. See README.md.

LAIL_HOST=0.0.0.0
LAIL_API_PORT=8787
LAIL_WEB_PORT=3000
LAIL_SERVE_ENGINE_PORT=8765
LAIL_ROOT=.
LAIL_DATA_DIR=./data
LAIL_WORKSPACES_DIR=./workspaces

# Backends: vllm | llamacpp only (no Ollama)
LAIL_DEFAULT_BACKEND=vllm
LAIL_VLLM_URL=http://127.0.0.1:8000
LAIL_LLAMACPP_URL=http://127.0.0.1:8080

# Served model id after vLLM is up, or "auto" to pick first /v1/models entry
LAIL_DEFAULT_MODEL=auto

# OpenAI-compatible base used by serve-engine probes/benches
LAB_BASE_URL=http://127.0.0.1:8000

# Optional Hugging Face token (gated models / higher rate limits)
HF_TOKEN=

# Dual-Spark cluster (optional JSON override). Defaults: spark1 local + spark2 via SSH.
# LAIL_CLUSTER_JSON={"name":"sfxnz-lab","nodes":[...]}

# Optional Spark paths (serve-engine)
# SPARK_LAB=~/benchmarks/_pipeline/spark_lab.sh
# VLLM_RUNTIME=~/vllm-runtime
