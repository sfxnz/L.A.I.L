{
  "model": "nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4",
  "mode": "workflow_max",
  "note": "Vendor 1x DGX Spark (GB10) recipe. Nemotron hybrid keeps --moe-backend marlin. Single-node envelope clamps card 1M context to 262144. DSpark draft model resolved from DSPARK_CKPT= on the card (export expand, not scrub-drop). Real NVFP4 blobs ~20 GiB — must fit 1 Spark (serve_blocked=false).",
  "weights_gib": 20.1,
  "expect": {
    "label_contains": "DGX Spark",
    "serve_blocked": false,
    "config": {
      "reasoning_parser": "nemotron_v3",
      "tool_call_parser": "qwen3_coder",
      "kv_cache_dtype": "fp8",
      "moe_backend": "marlin",
      "enable_prefix_caching": true,
      "enable_auto_tool_choice": true,
      "trust_remote_code": true,
      "max_model_len": 262144,
      "quantization": "modelopt_mixed"
    },
    "extra_flags_contains": [
      "--mamba-backend flashinfer",
      "--mamba-cache-mode align",
      "--speculative_config.method dspark",
      "--speculative_config.model nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark"
    ],
    "forbidden": [
      "humming",
      "$MODEL",
      "--model "
    ]
  }
}
