[
  {
    "match": {
      "all": ["minimax"],
      "any": ["m2", "m2.1", "m2.5", "m2.7"],
      "family": ["minimax_m2"]
    },
    "family_key": "minimax_m2",
    "label": "MiniMax M2 (DGX Spark)",
    "source": "https://huggingface.co/MiniMaxAI",
    "config": {
      "trust_remote_code": true,
      "reasoning_parser": "minimax_m2",
      "tool_call_parser": "minimax_m2",
      "enable_auto_tool_choice": true,
      "kv_cache_dtype": "fp8",
      "docker_env": [
        "SAFETENSORS_FAST_GPU=1",
        "CUTE_DSL_ARCH=sm_121a",
        "VLLM_NVFP4_GEMM_BACKEND=flashinfer-cutlass"
      ],
      "extra_flags": "--compilation-config '{\"cudagraph_mode\":\"none\"}'"
    },
    "rationale": [
      "MiniMax M2 on GB10: parsers + FP8 KV; cudagraph none avoids known NVFP4 compile stalls.",
      "Prefer NVFP4 ~130 GiB across 2 Sparks (TP=2); FP8 is heavier — placement sizes nodes from weights."
    ]
  },
  {
    "match": {
      "all": ["minimax"],
      "any": ["m3"],
      "family": ["minimax_m3"]
    },
    "family_key": "minimax_m3",
    "label": "MiniMax M3 (parsers + MSA block-size; weight-fit usually blocks 1–2 Sparks)",
    "source": "https://huggingface.co/MiniMaxAI",
    "config": {
      "trust_remote_code": true,
      "reasoning_parser": "minimax_m3",
      "tool_call_parser": "minimax_m3",
      "enable_auto_tool_choice": true,
      "extra_flags": "--block-size 128 --language-model-only --default-chat-template-kwargs '{\"thinking_mode\":\"enabled\"}'"
    },
    "rationale": [
      "M3 MSA requires --block-size 128; language-model-only keeps Spark off the VL tower.",
      "Full M3 weights usually exceed 2× GB10 — serve_blocked / Start refuse via placement floors."
    ]
  },
  {
    "match": {
      "all": ["mistral"],
      "any": ["magistral", "devstral"],
      "family": ["mistral"]
    },
    "family_key": "mistral_common",
    "label": "Mistral / Magistral (mistral-common load path)",
    "source": "https://docs.vllm.ai",
    "config": {
      "trust_remote_code": true,
      "load_format": "mistral",
      "tool_call_parser": "mistral",
      "enable_auto_tool_choice": true,
      "reasoning_parser": "mistral",
      "extra_flags": "--tokenizer-mode mistral --config-format mistral"
    },
    "rationale": [
      "Magistral/Devstral cards expect mistral-common tokenizer/config/load_format."
    ]
  },
  {
    "match": {
      "all": ["qwen3.8", "nvfp4"],
      "any": [],
      "family": ["qwen"]
    },
    "family_key": "qwen38_nvfp4",
    "label": "Qwen3.8 NVFP4 (native VL)",
    "source": "https://unsloth.ai/docs/models/qwen3.8",
    "config": {
      "trust_remote_code": true,
      "reasoning_parser": "qwen3",
      "tool_call_parser": "qwen3_coder",
      "enable_auto_tool_choice": true,
      "kv_cache_dtype": "fp8"
    },
    "rationale": [
      "Unsloth/Qwen NVFP4 cards have no parseable vllm serve (docs are a bare serve). Parsers + FP8 KV from Unsloth's calibrated cache.",
      "Vision stays on; hardware envelope sizes util / max-len from live UMA."
    ]
  },
  {
    "match": {
      "all": ["nvidia", "qwen3.6", "35b", "a3b"],
      "any": ["nvfp4"],
      "family": ["qwen"]
    },
    "family_key": "qwen36_35b_nvfp4_playbook",
    "label": "Qwen3.6 35B-A3B NVFP4 (DGX Spark playbook)",
    "source": "https://github.com/NVIDIA/dgx-spark-playbooks/blob/main/nvidia/vllm/README.md",
    "config": {
      "trust_remote_code": true,
      "reasoning_parser": "qwen3",
      "tool_call_parser": "qwen3_xml",
      "enable_auto_tool_choice": true,
      "kv_cache_dtype": "fp8",
      "moe_backend": "marlin",
      "mtp": true,
      "mtp_num_tokens": 3,
      "mtp_moe_backend": "triton",
      "enable_chunked_prefill": true,
      "enable_prefix_caching": true,
      "extra_flags": "--attention-backend flashinfer --async-scheduling --load-format fastsafetensors --max-num-batched-tokens 8192"
    },
    "rationale": [
      "NVIDIA dgx-spark-playbooks Agent Ready Qwen3.6 35B: marlin + qwen3_xml + flashinfer attention + MTP 3.",
      "MTP speculative-config carries moe_backend:triton (draft MoE); top-level --moe-backend stays marlin.",
      "Do not apply this overlay to Unsloth 35B (that path keeps flashinfer_b12x).",
      "Playbook MTP 3 is kept on vLLM ≥0.27; hardware envelope sizes util / max-len."
    ]
  },
  {
    "match": {
      "all": ["diffusiongemma"],
      "any": [],
      "family": []
    },
    "family_key": "diffusiongemma",
    "label": "DiffusionGemma (DGX Spark playbook)",
    "source": "https://github.com/NVIDIA/dgx-spark-playbooks/blob/main/nvidia/vllm/README.md",
    "config": {
      "reasoning_parser": "gemma4",
      "tool_call_parser": "gemma4",
      "enable_auto_tool_choice": true,
      "enable_prefix_caching": true,
      "load_format": "fastsafetensors",
      "docker_env": [
        "VLLM_USE_V2_MODEL_RUNNER=1"
      ],
      "extra_flags": "--attention-backend TRITON_ATTN --diffusion-config '{\"canvas_length\":256}' --override-generation-config '{\"max_new_tokens\": null}' --default-chat-template-kwargs '{\"enable_thinking\": true}'"
    },
    "rationale": [
      "NVIDIA DGX Spark playbook: DiffusionGemma uses vllm/vllm-openai:gemma (image pin is resolver-owned).",
      "V2 model runner + TRITON_ATTN + --diffusion-config canvas_length=256; parsers stay gemma4."
    ]
  },
  {
    "match": {
      "all": [],
      "any": ["gemma-4", "gemma4", "gemma_4"],
      "family": ["gemma4"]
    },
    "family_key": "gemma4",
    "label": "Gemma 4 (parsers)",
    "source": "https://github.com/NVIDIA/dgx-spark-playbooks/blob/main/nvidia/vllm/README.md",
    "gap_only": true,
    "config": {
      "reasoning_parser": "gemma4",
      "tool_call_parser": "gemma4",
      "enable_auto_tool_choice": true
    },
    "rationale": [
      "Gemma 4 family: --reasoning-parser gemma4 + --tool-call-parser gemma4.",
      "Parsers-only — official 31B extras (--chat-template / --async-scheduling / --limit-mm-per-prompt) stay.",
      "Image pin vllm/vllm-openai:gemma4-cu130 is resolver-owned (not this overlay)."
    ]
  },
  {
    "match": {
      "all": ["gpt-oss"],
      "any": [],
      "family": []
    },
    "family_key": "gpt_oss",
    "label": "GPT-OSS (MXFP4)",
    "source": "https://docs.vllm.ai/en/latest/features/tool_calling/",
    "config": {
      "quantization": "mxfp4",
      "tool_call_parser": "openai",
      "enable_auto_tool_choice": true
    },
    "rationale": [
      "GPT-OSS checkpoints ship MXFP4 MoE weights; vLLM tool parser is openai.",
      "Card is a bare `vllm serve` — no expert/DP crash flags on the 1–2× GB10 path."
    ]
  }
]
