# L.A.I.L — Local AI Lab
# Copy to .env and adjust. See README.md.

LAIL_HOST=0.0.0.0
LAIL_API_PORT=8787
LAIL_WEB_PORT=3000
LAIL_SERVE_ENGINE_PORT=8765
LAIL_ROOT=.
LAIL_DATA_DIR=./data
LAIL_WORKSPACES_DIR=./workspaces

# Backends: vllm | llamacpp only (no Ollama)
LAIL_DEFAULT_BACKEND=vllm
LAIL_VLLM_URL=http://127.0.0.1:8000
LAIL_LLAMACPP_URL=http://127.0.0.1:8080

# Served model id after vLLM is up, or "auto" to pick first /v1/models entry
LAIL_DEFAULT_MODEL=auto

# OpenAI-compatible base used by serve-engine probes/benches
LAB_BASE_URL=http://127.0.0.1:8000

# Optional Hugging Face token (gated models / higher rate limits)
HF_TOKEN=

# Extra Next.js allowedDevOrigins (comma-separated). Loopback is already allowed.
# LAIL_DEV_ORIGINS=lab.example,10.0.0.12

# Cluster topology (optional). Unset = one local node (id=local, http://127.0.0.1:8000).
# Multi-node is opt-in via LAIL_CLUSTER_JSON or gitignored data/cluster.json.
#
# EXAMPLE only — 2-node lab. Replace every <placeholder>. This is NOT the clone default.
# LAIL_CLUSTER_JSON={"name":"example-lab","nodes":[{"id":"head","label":"head","role":"head","local":true,"vllm_url":"http://127.0.0.1:8000","qsfp_ip":"<head-qsfp>","qsfp_if":"<iface>"},{"id":"worker","label":"worker","role":"worker","local":false,"ssh_host":"<worker-host>","vllm_url":"http://127.0.0.1:8000","qsfp_ip":"<worker-qsfp>","qsfp_if":"<iface>"}]}

# Optional serve-engine overrides (paths you set; not required to clone)
# SPARK_LAB=
# VLLM_RUNTIME=
